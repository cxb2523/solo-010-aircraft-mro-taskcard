      "trade": "机械",
      "type": "routine",
      "plannedFinish": "2026-09-22T18:00:00+08:00",
      "steps": [
        { "stepNo": 1, "content": "接收工卡，确认飞机站位并设置挡轮、挂出禁止靠近标牌", "trade": "机械", "requiresDual": false, "materials": [], "dependsOn": [] },
        { "stepNo": 2, "content": "打开发动机下部滑油接近盖板，检查盖板与锁扣状态", "trade": "机械", "requiresDual": false, "materials": [], "dependsOn": [1] },
        { "stepNo": 3, "content": "检查滑油箱外观及管路接头有无渗漏痕迹", "trade": "机械", "requiresDual": false, "materials": [], "dependsOn": [2] },
        { "stepNo": 4, "content": "测量滑油消耗量并记录，与上一航段数据比对", "trade": "机械", "requiresDual": false, "materials": [], "dependsOn": [3] },
        { "stepNo": 5, "content": "补充同牌号滑油至规定刻度线", "trade": "机械", "requiresDual": false, "materials": [{ "code": "MAT-OIL-2380", "name": "MIL-PRF-23699 滑油", "qty": 2 }], "dependsOn": [4] },
        { "stepNo": 6, "content": "更换滑油系统磁性堵头封圈并检查吸附金属屑情况", "trade": "机械", "requiresDual": false, "materials": [{ "code": "MAT-SEAL-771", "name": "磁性堵头封圈", "qty": 1 }], "dependsOn": [4] },
        { "stepNo": 7, "content": "更换滑油滤堵头密封垫圈", "trade": "机械", "requiresDual": false, "materials": [{ "code": "MAT-WASHER-12", "name": "堵头密封垫圈", "qty": 1 }], "dependsOn": [6] },
        { "stepNo": 8, "content": "复装接近盖板并确认锁扣到位", "trade": "机械", "requiresDual": false, "materials": [], "dependsOn": [5, 7] },
        { "stepNo": 9, "content": "执行滑油系统通电自检，确认无相关警告信息", "trade": "电子", "requiresDual": false, "materials": [], "dependsOn": [8] },
        { "stepNo": 10, "content": "清理工作现场，核对工具数量并归还", "trade": "机械", "requiresDual": false, "materials": [], "dependsOn": [9] },
        { "stepNo": 11, "content": "签署工卡执行结论，双人复核各步骤签署完整性", "trade": "机械", "requiresDual": true, "materials": [], "dependsOn": [10] },
        { "stepNo": 12, "content": "签署工卡，授权飞机恢复可用状态", "trade": "放行", "requiresDual": false, "materials": [], "dependsOn": [11] }
      ]
    },
    {
